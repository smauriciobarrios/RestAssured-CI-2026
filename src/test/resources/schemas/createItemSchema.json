{
  "id": "http://json-schema.org/draft-04/schema#",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "Id": { "type": "integer", "minimum": 1 },
    "Content": { "type": "string", "minLength": 1 },
    "ItemType": { "type": "integer" },
    "Checked": { "type": "boolean" },
    "ProjectId": { "type": ["integer", "null"] },
    "ParentId": { "type": ["integer", "null"] },
    "Path": { "type": "string" },
    "Collapsed": { "type": "boolean" },
    "DateString": { "type": ["string", "null"] },
    "DateStringPriority": { "type": "integer" },
    "DueDate": { "type": "string" },
    "Recurrence": { "type": ["string", "null"] },
    "ItemOrder": { "type": ["integer", "null"] },
    "Priority": { "type": "integer" },
    "LastSyncedDateTime": { "type": "string" },
    "Children": { "type": "array" },
    "DueDateTime": { "type": ["string", "null"] },
    "CreatedDate": { "type": "string" },
    "LastCheckedDate": { "type": ["string", "null"] },
    "LastUpdatedDate": { "type": "string" },
    "Deleted": { "type": "boolean" },
    "Notes": { "type": "string" },
